# Environmental Configuration Template (Copy to .env and provide your values)
ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/disaster_db
REDIS_URL=redis://localhost:6379/0
GEMINI_API_KEY=your-gemini-api-key-here
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_REFRESH_SECRET_KEY=change-this-to-a-secure-random-refresh-key

